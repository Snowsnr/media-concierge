# Private homelab API only. Never expose these values to a browser or commit them.
SUPABASE_URL=
SUPABASE_BRIDGE_TOKEN=
BROKER_POLL_INTERVAL_MS=15000

# Supabase Edge Function secrets (set with `supabase secrets set`, not in Git).
