# Local mock-only defaults. Do not add real credentials to this file.
CONCIERGE_API_PORT=4100
VITE_CONCIERGE_API_URL=http://localhost:4100
CONCIERGE_DB_PATH=./data/media-concierge.db
LOG_LEVEL=info
CORS_ORIGINS=

# Phase 2 public portal. The anon key is intentionally public and protected by RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Private homelab API only. Never expose these values to a browser or commit them.
SUPABASE_URL=
SUPABASE_BRIDGE_TOKEN=
BROKER_POLL_INTERVAL_MS=15000

# Phase 4 private Radarr adapter. Leave URL/key empty to keep the safe mock.
RADARR_URL=
RADARR_API_KEY=
RADARR_QUALITY_PROFILE_ID=
RADARR_ROOT_FOLDER_PATH=
RADARR_TAG_IDS=

# Phase 5 private qBittorrent adapter. Prefer API key on qBittorrent 5.2+.
QBITTORRENT_URL=
QBITTORRENT_API_KEY=
# Fallback for older qBittorrent versions; leave empty when using an API key.
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=

# Phase 6 private Bazarr adapter. Keep both values only in the homelab environment.
BAZARR_URL=
BAZARR_API_KEY=

# Supabase Edge Function secrets (set with `supabase secrets set`, not in Git).
TMDB_API_READ_TOKEN=
HOMELAB_BRIDGE_TOKEN=
PUBLIC_PORTAL_ORIGIN=https://pedidos.diegohomelab.fyi
